# ---------------------------------------------------------------------------
# AapdaSaathi backend configuration (copy to worker/.env — never commit .env)
# ---------------------------------------------------------------------------

# Environment: development | test | demo | production
APP_ENV=development

# SAFETY SWITCH. Live/real alerts are ingested and displayed, but NO notification
# is sent to a non-demo resident unless this is true AND the deployment has been
# explicitly authorised. Keep false for development, testing, demos and initial deploys.
NOTIFY_REAL_RESIDENTS=false

# Database. Local zero-setup demo uses SQLite; production uses Supabase Postgres + PostGIS.
#   postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./data/aapdasaathi.db

# Auth: "local" = backend-issued JWT (OTP / demo personas); "supabase" = verify Supabase JWTs
AUTH_MODE=local
# Long random string (>= 32 chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=720
# Only for AUTH_MODE=supabase (Project Settings -> API -> JWT secret)
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Demo / drill mode. Disable in production.
DEMO_MODE_ENABLED=true
# Escalation interval used for demo incidents (seconds) so the 3-minute demo is watchable.
DEMO_ESCALATION_INTERVAL_SECONDS=30

# SACHET (NDMA) public CAP feeds
SACHET_RSS_URLS=https://sachet.ndma.gov.in/cap_public_website/rss/rss_uttarakhand.xml
SACHET_CAP_URL_TEMPLATE=https://sachet.ndma.gov.in/cap_public_website/FetchXMLFile?identifier={identifier}
FEED_POLL_SECONDS=45
FEED_POLL_ENABLED=false

# Background jobs (escalation ticks, feed polling) inside the API process
RUN_BACKGROUND_JOBS=true
ESCALATION_TICK_SECONDS=5

# Dispatch safety
WALKING_SPEED_M_PER_MIN=75
HILL_TERRAIN_FACTOR=1.4
ASSIST_BUFFER_MINUTES=10
MAX_WALK_MINUTES_ACTIVE_HAZARD=15

# Push notifications (Firebase Cloud Messaging). Leave empty to use the in-app channel only.
# Path to a service-account JSON stored OUTSIDE the repository.
FIREBASE_CREDENTIALS_FILE=

# SMS gateway: "simulator" (demo outbox) or "httpsms" (self-hosted/hosted httpSMS)
SMS_PROVIDER=simulator
HTTPSMS_API_URL=https://api.httpsms.com/v1/messages/send
HTTPSMS_API_KEY=
HTTPSMS_FROM_NUMBER=
# Shared secret used to verify inbound SMS webhooks (httpSMS webhook signing key)
SMS_WEBHOOK_SECRET=replace-with-webhook-signing-key

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://127.0.0.1:8080,http://127.0.0.1:8081

# Simulator-only: fictional numbers that behave like a switched-off phone (shows UNREACHABLE)
SIM_UNREACHABLE_PHONES=+919000000013
# Real phones allowed to receive DEMO-incident SMS through a real gateway (on-stage demo). Empty = simulator only.
DEMO_SMS_ALLOWLIST=
