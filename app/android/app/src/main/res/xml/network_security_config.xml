<?xml version="1.0" encoding="utf-8"?>
<!-- Local development only: allows plain HTTP to the AapdaSaathi backend on the emulator host
     (10.0.2.2), localhost and LAN IPs. Production deployments must use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
